<?xml version="1.0" encoding="utf-8"?>
<!-- Languages offered in Android's per-app language setting (Settings > Apps > App languages),
     so the plugin's example order can match Uber Eats' language -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="es" />
</locale-config>
